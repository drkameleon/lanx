import "mimetypes"!

;-----------------------------------------------
; Template
;-----------------------------------------------

ListingTemplate: read ./"templates/listing.html"

;-----------------------------------------------
; Main type
;-----------------------------------------------

define :lanx [

    init: method [][
        \root: path\current
        \port: 18966

        \fixedBinary?: sys\version > 0.10.0
    ]

    ;-------------------------------------------
    ; Internal helpers
    ;-------------------------------------------

    serveFile: method [filepath][
        content: read.binary filepath
        ct: mimetype filepath

        contentType: (empty? ct)? -> "application/octet-stream"
                                  -> first ct

        unless \fixedBinary? ->
            content: to :string content
        
        #[
            body: content
            status: 200
            headers: #[
                "Content-Type": contentType
            ]
        ]
    ]

    directoryListing: method [dirPath, urlPath][
        items: list dirPath

        entries: new []
        loop sort items 'item [
            unless hidden? item [
                name: extract.basename item
                'entries ++ (directory? item)? -> name ++ "/"
                                               -> name
            ]
        ]

        #[
            body: render.template ListingTemplate
            status: 200
            headers: #[
                "Content-Type": "text/html"
            ]
        ]
    ]

    redirect: method [target][
        #[
            body: ""
            status: 301
            headers: #[
                "Content-Type": "text/html"
                "Location": target
            ]
        ]
    ]

    handle: method [req][
        reqPath: req\path

        if contains? reqPath ".." ->
            return #[body: "Forbidden" status: 403 headers: #["Content-Type": "text/plain"]]

        fullPath: (reqPath = "/")? -> \root
                                -> \root ++ reqPath

        if and? [exists? fullPath][directory? fullPath] [
            unless suffix? reqPath "/" ->
                return \redirect reqPath ++ "/"

            indexPath: fullPath ++ "/index.html"
            if exists? indexPath ->
                return \serveFile indexPath

            return \directoryListing fullPath reqPath
        ]

        if and? [exists? fullPath][file? fullPath] ->
            return \serveFile fullPath

        #[body: "Not Found" status: 404 headers: #["Content-Type": "text/plain"]]
    ]

    ;-------------------------------------------
    ; Start
    ;-------------------------------------------

    start: method [][
        unless directory? \root [
            print ~"Error: '|\root|' is not a valid directory."
            exit
        ]

        print ~" :: Serving |\root|"

        serve .port: \port $[req] ->
            \handle req
    ]
]
